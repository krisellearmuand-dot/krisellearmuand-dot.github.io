/* =========================================
   Y2K WINDOW SYSTEM
========================================= */

let highestZ = 100;

const taskbar = document.getElementById("taskbar");

document.querySelectorAll(".window").forEach(windowEl => {

  const header = windowEl.querySelector(".window-top");

  const minimizeBtn =
    windowEl.querySelector(".minimize");

  const closeBtn =
    windowEl.querySelector(".close");

  const title =
    header.querySelector("span").innerText;

  let isDragging = false;

  let offsetX = 0;
  let offsetY = 0;

  /* =========================
     BRING WINDOW FRONT
  ========================= */

  function focusWindow(){

    highestZ++;

    windowEl.style.zIndex = highestZ;
  }

  windowEl.addEventListener("mousedown",focusWindow);

  /* =========================
     DRAGGING
  ========================= */

  header.addEventListener("mousedown",(e)=>{

    if(
      e.target.tagName === "BUTTON"
    ) return;

    isDragging = true;

    focusWindow();

    offsetX = e.clientX - windowEl.offsetLeft;
    offsetY = e.clientY - windowEl.offsetTop;

  });

  document.addEventListener("mousemove",(e)=>{

    if(!isDragging) return;

    windowEl.style.left =
      e.clientX - offsetX + "px";

    windowEl.style.top =
      e.clientY - offsetY + "px";

  });

  document.addEventListener("mouseup",()=>{

    isDragging = false;

  });

  /* =========================
     TASKBAR TAB
  ========================= */

  const taskBtn =
    document.createElement("div");

  taskBtn.className = "taskbar-app";

  taskBtn.innerText = title;

  taskbar.appendChild(taskBtn);

  /* =========================
     MINIMIZE
  ========================= */

  let minimized = false;

  minimizeBtn.addEventListener("click",()=>{

    minimized = !minimized;

    if(minimized){

      windowEl.style.display = "none";

    }else{

      windowEl.style.display = "block";

      focusWindow();

    }

  });

  /* =========================
     TASKBAR REOPEN
  ========================= */

  taskBtn.addEventListener("click",()=>{

    if(
      windowEl.style.display === "none"
    ){

      windowEl.style.display = "block";

      minimized = false;

      focusWindow();

    }else{

      windowEl.style.display = "none";

      minimized = true;

    }

  });

  /* =========================
     CLOSE
  ========================= */

  closeBtn.addEventListener("click",()=>{

    windowEl.style.display = "none";

    minimized = true;

  });

});
