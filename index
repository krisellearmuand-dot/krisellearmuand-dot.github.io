// ==================== BREACH PROTOCOL WITH A* ====================
let matrixData = [];
let requiredSequence = ["1C", "7A", "7A", "E9", "1C"];

const matrixContainer = document.getElementById("code-matrix");
const bufferDisplay = document.getElementById("buffer-display");
const requiredSeqEl = document.getElementById("required-sequence");

const codesPool = ["1C","7A","E9","BD","55","DA","F0","3B"];

function getNeighbors(index) {
  const row = Math.floor(index / 6), col = index % 6;
  const dirs = [[-1,0],[1,0],[0,-1],[0,1]];
  const neighbors = [];
  for (let [dr, dc] of dirs) {
    const r = row + dr, c = col + dc;
    if (r >= 0 && r < 6 && c >= 0 && c < 6) neighbors.push(r*6 + c);
  }
  return neighbors;
}

function findPathWithAStar() {
  const startNodes = matrixData.map((val, i) => val === requiredSequence[0] ? i : -1).filter(i => i !== -1);
  for (let start of startNodes) {
    let openSet = [{ pos: start, path: [start], remaining: requiredSequence.slice(1) }];
    let visited = new Set();
    while (openSet.length > 0) {
      openSet.sort((a, b) => a.remaining.length - b.remaining.length);
      const current = openSet.shift();
      if (current.remaining.length === 0) return current.path;
      const key = `${current.pos}-${current.remaining.length}`;
      if (visited.has(key)) continue;
      visited.add(key);
      for (let neighbor of getNeighbors(current.pos)) {
        if (current.remaining[0] === matrixData[neighbor]) {
          openSet.push({ pos: neighbor, path: [...current.path, neighbor], remaining: current.remaining.slice(1) });
        }
      }
    }
  }
  return null;
}

function highlightPath(path) {
  clearBreach();
  path.forEach((index, step) => {
    setTimeout(() => {
      const cells = matrixContainer.children;
      if (cells[index]) cells[index].classList.add("path", "selected");
    }, step * 100);
  });
}

function autoSolveWithAStar() {
  const path = findPathWithAStar();
  if (path) {
    highlightPath(path);
    setTimeout(() => alert("✅ A* OPTIMAL PATH FOUND!\nBreach Successful."), path.length * 110);
  } else alert("❌ No valid path found.");
}

function generateMatrix() {
  matrixData = [];
  for (let i = 0; i < 36; i++) matrixData.push(codesPool[Math.floor(Math.random() * codesPool.length)]);
}

function renderMatrix() {
  matrixContainer.innerHTML = "";
  matrixData.forEach((code, i) => {
    const cell = document.createElement("div");
    cell.className = "matrix-cell";
    cell.textContent = code;
    matrixContainer.appendChild(cell);
  });
}

