  renderMatrix();
  bufferDisplay.innerHTML = "";
  requiredSeqEl.textContent = requiredSequence.join(" ");
}

function clearBreach() {
  const cells = matrixContainer.children;
  for (let cell of cells) cell.classList.remove("selected", "path");
  bufferDisplay.innerHTML = "";
}

